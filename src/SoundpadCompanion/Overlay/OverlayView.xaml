<UserControl x:Class="SoundpadCompanion.Overlay.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="660">

    <UserControl.Resources>
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,7,12,7" Margin="0,1">
                            <Grid>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="-9,2,0,2" Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C6670" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Query}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="#33414A"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search line -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Canvas Width="22" Height="22" Margin="2,0,12,0" VerticalAlignment="Center">
                    <Ellipse Width="15" Height="15" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4" />
                    <Line X1="13" Y1="13" X2="20" Y2="20" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <TextBlock Grid.Column="1" Text="Search your sounds" Style="{StaticResource Placeholder}"
                           VerticalAlignment="Center" Margin="2,0,0,0" />
                <TextBox x:Name="SearchBox" x:FieldModifier="public" Grid.Column="1"
                         Style="{StaticResource BareTextBox}" FontSize="20" Height="36"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="-16,12,-16,8" />

            <!-- Heading + status -->
            <DockPanel Grid.Row="2" Margin="2,0,2,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource StatusText}" />
                <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionLabel}" Margin="0" />
            </DockPanel>

            <!-- Results -->
            <Grid Grid.Row="3">
                <ListBox x:Name="ResultsList" x:FieldModifier="public"
                         ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
                         ItemContainerStyle="{StaticResource ResultItem}"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         MaxHeight="420" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11.5"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding NoMatchesText}" Style="{StaticResource Muted}" FontSize="13"
                           Margin="2,10,2,14"
                           Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- Key hints -->
            <WrapPanel Grid.Row="4" Margin="2,10,0,0">
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Click" FontSize="11" /></Border>
                <TextBlock Text="or" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" FontSize="11" /></Border>
                <TextBlock Text="play" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Text="hold" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Shift" FontSize="11" /></Border>
                <TextBlock Text="speakers only" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" FontSize="11" /></Border>
                <TextBlock Text="mic only" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" FontSize="11" /></Border>
                <TextBlock Text="close" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
